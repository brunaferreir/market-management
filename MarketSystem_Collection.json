{
  "info": {
    "_postman_id": "0f8b0c34-5e76-40bf-b9b6-a456bdd3848e",
    "name": "MarketSystem",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Coleção para testar a API Market System (Flask) com JWT."
  },
  "item": [
    {
      "name": "1) Healthcheck - API no ar",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response tem mensagem esperada', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('mensagem');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2) Cadastrar Seller",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Mercado Central\",\n  \"cnpj\": \"12345678000199\",\n  \"email\": \"mercado@email.com\",\n  \"celular\": \"11999999999\",\n  \"senha\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/sellers",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "sellers"
          ]
        }
      }
    },
    {
      "name": "3) Ativar Seller (código WhatsApp)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"celular\": \"11970507045\",\n  \"codigo\": \"1234\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/sellers/activate",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "sellers",
            "activate"
          ]
        }
      }
    },
    {
      "name": "4) Login (gera JWT)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"mercado@email.com\",\n  \"senha\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Salvar token em variável de ambiente', function () {",
              "  const json = pm.response.json();",
              "  if (json && json.token) {",
              "    pm.environment.set('token', json.token);",
              "  }",
              "  pm.expect(pm.environment.get('token')).to.be.ok;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5) Rota protegida /me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        }
      }
    },
